<ui:FluentWindow x:Class="DriverGuard.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:DriverGuard.UI.ViewModels"
        xmlns:enums="clr-namespace:DriverGuard.Core.Enums;assembly=DriverGuard.Core"
        mc:Ignorable="d"
        Title="DriverGuard — Auditoria, Instalação e Reversão Segura de Drivers (Modo Administrador)"
        Height="880" Width="1380"
        MinHeight="640" MinWidth="1040"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header com Logo, Contadores e Ações Rápidas -->
            <RowDefinition Height="Auto" />
            <!-- Barra de Comandos, Filtros e Pesquisa -->
            <RowDefinition Height="Auto" />
            <!-- Conteúdo Principal (Abas) -->
            <RowDefinition Height="*" />
            <!-- Detalhes do Dispositivo Selecionado -->
            <RowDefinition Height="Auto" />
            <!-- Barra de Status e Progresso -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="12,8" Background="{DynamicResource CardBackground}" CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="26" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel>
                        <TextBlock Text="DriverGuard" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Auditoria PnP, Instalação Controlada, Reversão e Histórico SQLite" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Contadores Rápidos -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Margin="6,0" Padding="10,4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalDevicesCount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="6,0" Padding="10,4" Background="#1A00FF00" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Atualizações: " FontSize="12" Foreground="#FF107C41" />
                            <TextBlock Text="{Binding UpdateAvailableCount}" FontSize="12" FontWeight="Bold" Foreground="#FF107C41" />
                        </StackPanel>
                    </Border>
                    <Border Margin="6,0" Padding="10,4" Background="#33D83B01" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Com Erros: " FontSize="12" Foreground="#FFE65C00" />
                            <TextBlock Text="{Binding ProblemsCount}" FontSize="12" FontWeight="Bold" Foreground="#FFE65C00" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Toggle Modo Simulação, Admin Badge e Tema -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Margin="0,0,14,0" Padding="8,4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Modo Simulação" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ui:ToggleSwitch IsChecked="{Binding IsSimulationMode, Mode=TwoWay}" ToolTip="Executa todo o fluxo de verificação e log sem modificar o DriverStore" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,10,0" Padding="8,4" Background="#2600FF00" CornerRadius="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="LockClosed20" FontSize="14" Foreground="#FF107C41" Margin="0,0,4,0"/>
                            <TextBlock Text="ADMIN" FontSize="10" FontWeight="Bold" Foreground="#FF107C41" />
                        </StackPanel>
                    </Border>
                    <ui:Button Command="{Binding ToggleThemeCommand}" ToolTip="Alternar tema Claro / Escuro" Icon="WeatherSunny24" Appearance="Subtle" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. BARRA DE COMANDOS, FILTROS E PESQUISA -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,10" Background="{DynamicResource CardBackground}" CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0"
                           Command="{Binding RefreshInventoryCommand}"
                           Appearance="Primary"
                           Icon="ArrowSync24"
                           Content="Inventário PnP"
                           Margin="0,0,6,0"
                           FontWeight="SemiBold" />

                <ui:Button Grid.Column="1"
                           Command="{Binding CheckUpdatesCommand}"
                           Appearance="Secondary"
                           Icon="ArrowDownload24"
                           Content="Verificar Atualizações"
                           Margin="0,0,6,0"
                           FontWeight="SemiBold" />

                <ui:Button Grid.Column="2"
                           Command="{Binding InspectFolderDriverCommand}"
                           Appearance="Subtle"
                           Icon="FolderSearch24"
                           Content="Validar de Pasta..."
                           Margin="0,0,6,0" />

                <ui:Button Grid.Column="3"
                           Command="{Binding CancelOperationCommand}"
                           Appearance="Danger"
                           Icon="Dismiss24"
                           Content="Cancelar"
                           Margin="0,0,12,0" />

                <ui:TextBox Grid.Column="4"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Buscar por nome, fabricante, classe ou Hardware ID (ex: VEN_8086)..."
                            Icon="Search24"
                            ClearButtonEnabled="True"
                            Margin="0,0,12,0" />

                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Classe:" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                    <ComboBox ItemsSource="{Binding AvailableClasses}"
                              SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                              MinWidth="130" />
                </StackPanel>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status:" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                    <ComboBox SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" MinWidth="130">
                        <ComboBoxItem Content="Todos" IsSelected="True" />
                        <ComboBoxItem Content="Atualizações Disponíveis" />
                        <ComboBoxItem Content="Atualizados" />
                        <ComboBoxItem Content="Com Problemas" />
                        <ComboBoxItem Content="Não Verificados" />
                        <ComboBoxItem Content="Ignorados" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. ABAS DE CONTEÚDO (Dispositivos / Problemas / Histórico) -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}">
            
            <!-- ABA 1: DISPOSITIVOS -->
            <TabItem Header="Todos os Dispositivos">
                <Grid Margin="0,8,0,0">
                    <DataGrid ItemsSource="{Binding DisplayedDevices}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                              Background="{DynamicResource CardBackground}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Dispositivo" Binding="{Binding Name}" Width="260" />
                            <DataGridTextColumn Header="Classe PnP" Binding="{Binding ClassName}" Width="100" />
                            <DataGridTextColumn Header="Fabricante" Binding="{Binding Manufacturer}" Width="120" />
                            <DataGridTextColumn Header="Versão Atual" Binding="{Binding DriverVersion}" Width="110" />
                            <DataGridTextColumn Header="Data do Driver" Binding="{Binding FormattedDriverDate}" Width="95" />
                            <DataGridTextColumn Header="Hardware ID Principal" Binding="{Binding PrimaryHardwareId}" Width="*" />

                            <DataGridTemplateColumn Header="Nível de Risco" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" Margin="4,0" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding IsCriticalRisk, StringFormat='Risco Alto'}"
                                                       FontSize="11" FontWeight="Bold" Foreground="#FFFF9500" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ABA 2: PROBLEMAS DETECTADOS -->
            <TabItem Header="Problemas Detectados">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,10" Padding="12" Background="#1AD83B01" BorderBrush="#FFE65C00" BorderThickness="1" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="20" Foreground="#FFE65C00" Margin="0,0,10,0"/>
                            <TextBlock Text="Dispositivos com código de erro PnP. Selecione um item e utilize o botão 'Reverter para Versão Anterior' se o problema tiver sido causado por uma atualização recente."
                                       TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ProblemDevices}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              Background="{DynamicResource CardBackground}"
                              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding ConfigManagerErrorCode, StringFormat='Erro {0}'}" Width="90" FontWeight="Bold" />
                            <DataGridTextColumn Header="Dispositivo" Binding="{Binding Name}" Width="240" />
                            <DataGridTextColumn Header="Classe" Binding="{Binding ClassName}" Width="120" />
                            <DataGridTextColumn Header="Explicação do Erro (Windows PnP)" Binding="{Binding StatusDescription}" Width="*" />
                            <DataGridTextColumn Header="Hardware ID" Binding="{Binding PrimaryHardwareId}" Width="240" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ABA 3: HISTÓRICO E AUDITORIA (FASE 4) -->
            <TabItem Header="Histórico e Auditoria">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Barra de Ações do Histórico -->
                    <Border Grid.Row="0" Margin="0,0,0,10" Padding="10" Background="{DynamicResource CardBackground}" CornerRadius="6" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:Button Grid.Column="0" Command="{Binding RefreshHistoryCommand}" Appearance="Secondary" Icon="ArrowSync24" Content="Recarregar" Margin="0,0,8,0" />

                            <ui:TextBox Grid.Column="1" Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filtrar histórico por dispositivo, hardware ID ou operação..." Icon="Search24" Margin="0,0,8,0" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="Resultado:" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <ComboBox SelectedItem="{Binding SelectedHistoryStatus, Mode=TwoWay}" MinWidth="130">
                                    <ComboBoxItem Content="Todos" IsSelected="True" />
                                    <ComboBoxItem Content="Sucesso" />
                                    <ComboBoxItem Content="Falha / Revertido" />
                                    <ComboBoxItem Content="Simulado" />
                                    <ComboBoxItem Content="Assinatura Inválida" />
                                    <ComboBoxItem Content="Bloqueado" />
                                </ComboBox>
                            </StackPanel>

                            <ui:Button Grid.Column="3" Command="{Binding ExportCsvCommand}" Appearance="Primary" Icon="ArrowDownload24" Content="Exportar CSV (Excel)" FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <!-- Tabela de Histórico SQLite -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DisplayedHistory}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              Background="{DynamicResource CardBackground}"
                              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data / Hora" Binding="{Binding FormattedTimestamp}" Width="145" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Operação" Binding="{Binding OperationType}" Width="130" />
                            <DataGridTextColumn Header="Dispositivo" Binding="{Binding DeviceName}" Width="220" />
                            <DataGridTextColumn Header="Versão Anterior" Binding="{Binding PreviousVersion}" Width="110" />
                            <DataGridTextColumn Header="Versão Nova" Binding="{Binding NewVersion}" Width="110" />
                            <DataGridTextColumn Header="Fonte" Binding="{Binding Source}" Width="130" />
                            <DataGridTextColumn Header="Resultado" Binding="{Binding ResultStatus}" Width="120" FontWeight="Bold" />
                            <DataGridTextColumn Header="Detalhes / Erro" Binding="{Binding ErrorMessage}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 4. PAINEL DE INSPEÇÃO E AÇÕES -->
        <Border Grid.Row="3" Margin="0,10,0,10" Padding="12" Background="{DynamicResource CardBackground}" CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Dispositivo Selecionado: " FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding SelectedDevice.Name, FallbackValue='Nenhum dispositivo selecionado'}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <!-- Banner de Atualização Disponível -->
                    <Border Background="#1A107C41" BorderBrush="#FF107C41" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,4,0,8"
                            Visibility="{Binding SelectedDeviceCandidate, Converter={x:Null}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="20" Foreground="#FF107C41" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ATUALIZAÇÃO OFICIAL HOMOLOGADA DISPONÍVEL" FontWeight="Bold" FontSize="11" Foreground="#FF107C41" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="Nova Versão: " FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedDeviceCandidate.NewVersion}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="Data: " FontSize="11" />
                                    <TextBlock Text="{Binding SelectedDeviceCandidate.FormattedNewDate}" FontSize="11" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                    <TextBlock Text="Fonte: " FontSize="11" />
                                    <TextBlock Text="{Binding SelectedDeviceCandidate.SourceName}" FontSize="11" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                    <TextBlock Text="Assinatura: " FontSize="11" />
                                    <TextBlock Text="{Binding SelectedDeviceCandidate.SignatureStatusSummary}" FontSize="11" FontWeight="Bold" Foreground="#FF107C41" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Hardware ID: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDevice.PrimaryHardwareId, Mode=OneWay}" IsReadOnly="True" FontSize="11" BorderThickness="0" Background="Transparent" Margin="0,0,12,0"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Class GUID: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SelectedDevice.ClassGuid, Mode=OneWay}" IsReadOnly="True" FontSize="11" BorderThickness="0" Background="Transparent" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Provedor: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDevice.DriverProvider, Mode=OneWay}" FontSize="11" Margin="0,4,12,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="INF Ativo: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedDevice.InfName, Mode=OneWay}" FontSize="11" Margin="0,4,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Botões de Ação -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <ui:Button Command="{Binding InstallSelectedCommand}"
                               Appearance="Primary"
                               Icon="ArrowDownload24"
                               Content="Instalar Atualização..."
                               FontWeight="Bold"
                               Margin="0,0,0,6" />

                    <ui:Button Command="{Binding RollbackDeviceCommand}"
                               Appearance="Secondary"
                               Icon="ArrowUndo24"
                               Content="Reverter Versão..."
                               Margin="0,0,0,6" />

                    <ui:Button Command="{Binding ToggleIgnoredCommand}"
                               CommandParameter="{Binding SelectedDevice}"
                               Appearance="Subtle"
                               Content="Alternar Ignorado" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. STATUS BAR & PROGRESSO ASSÍNCRONO -->
        <Border Grid.Row="4" Padding="10,6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />

                <ProgressBar Grid.Column="1"
                             Value="{Binding ProgressPercentage, Mode=OneWay}"
                             Maximum="100"
                             Height="10"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={x:Null}}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
