<ui:FluentWindow x:Class="DriverGuard.UI.Views.Dialogs.FolderDriverDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Instalar de Pasta — Inspeção e Validação de Autenticidade"
        Height="620" Width="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Validação de Driver em Pasta Local" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Selecione o diretório contendo o arquivo .INF e o catálogo assinado (.CAT). O DriverGuard validará a assinatura digital e a correspondência com o dispositivo selecionado."
                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Seletor de Pasta -->
        <Border Grid.Row="1" Padding="12" Background="{DynamicResource CardBackground}" CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox x:Name="TxtFolderPath" Grid.Column="0" PlaceholderText="Caminho da pasta do driver (ex: C:\Drivers\IntelEthernet)..." Margin="0,0,8,0" />
                <ui:Button x:Name="BtnBrowse" Grid.Column="1" Content="Procurar..." Icon="FolderOpen24" Click="BtnBrowse_Click" Margin="0,0,8,0" />
                <ui:Button x:Name="BtnInspect" Grid.Column="2" Appearance="Primary" Content="Validar Pacote" Icon="Checkmark24" Click="BtnInspect_Click" />
            </Grid>
        </Border>

        <!-- Resultados da Inspeção -->
        <Border Grid.Row="2" Padding="16" Background="{DynamicResource CardBackground}" CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PnlResults">
                    <!-- Dispositivo Selecionado -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="10" CornerRadius="6" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Dispositivo Alvo:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TxtTargetDevice" Text="Intel Ethernet Controller" FontSize="13" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock x:Name="TxtTargetHwId" Text="PCI\VEN_8086&amp;DEV_1234" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Status da Assinatura Digital -->
                    <Border x:Name="BdrSignatureStatus" Background="#1A00FF00" BorderBrush="#FF107C41" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="IcoSignature" Symbol="ShieldCheckmark24" FontSize="26" Foreground="#FF107C41" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="TxtSignatureTitle" Text="Assinatura Digital Válida (WHQL)" FontSize="13" FontWeight="Bold" Foreground="#FF107C41" />
                                <TextBlock x:Name="TxtSignatureSigner" Text="Signer: Microsoft Windows Hardware Compatibility Publisher" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="TxtSignatureError" Text="" FontSize="11" Foreground="#FFFF3B30" Visibility="Collapsed" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Comparação de Versões e Datas -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Atual -->
                        <Border Grid.Column="0" Margin="0,0,6,0" Padding="10" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="DRIVER ATUAL INSTALADO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TxtCurrentVersion" Text="Versão: 1.0.0.0" FontSize="12" Margin="0,4,0,0" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtCurrentDate" Text="Data: 01/01/2022" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Novo -->
                        <Border Grid.Column="1" Margin="6,0,0,0" Padding="10" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="NOVO DRIVER DA PASTA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="TxtNewVersion" Text="Versão: 2.1.0.0" FontSize="12" Margin="0,4,0,0" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="TxtNewDate" Text="Data: 15/03/2024" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Detalhes do Arquivo INF -->
                    <StackPanel>
                        <TextBlock Text="Arquivo INF Analisado:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TxtInfPath" Text="C:\Drivers\net.inf" FontFamily="Consolas" FontSize="11" Margin="0,2,0,8" />

                        <TextBlock Text="Hardware IDs Declarados no INF:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="TxtMatchedHwIds" IsReadOnly="True" Height="70" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer com Botões -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="TxtValidationSummary" Text="Aguardando seleção de diretório..." VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Fechar" Click="BtnClose_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
